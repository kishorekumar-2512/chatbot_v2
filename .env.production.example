# ── Database (Shared Managed Cloud PostgreSQL) ──────────────────────────────
# Format: postgresql://username:password@your-managed-db.region.rds.amazonaws.com:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@your-cloud-db.rds.amazonaws.com:5432/intern_db

# ── Primary LLM & Fallback Chain ─────────────────────────────────────────────
PRIMARY_LLM=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192

# ── Semantic Retrieval & Hybrid RAG (ChromaDB) ───────────────────────────────
CHROMA_DB_PATH=/app/embeddings/chroma_store
RETRIEVAL_TOP_K=8
REINDEX_INTERVAL_HOURS=24
ADMIN_API_KEY=your_secure_admin_api_key

# ── Production Storage Mounts (Shared across Blue/Green) ─────────────────────
KEY_STORE_PATH=/app/data/llm_keys.json
LLM_FAILURE_LOG_PATH=/app/data/llm_failures.jsonl
FEEDBACK_LOG_PATH=/app/feedback/feedback_log.jsonl
REPORTS_DIR=/app/reports

# ── Security & Authentication ────────────────────────────────────────────────
# Set to true for JWT SSO production token verification
REQUIRE_AUTH=false
# JWKS_URI=https://your-auth-domain/.well-known/jwks.json
# JWT_AUDIENCE=your-app-audience
# JWT_ISSUER=https://your-auth-domain
